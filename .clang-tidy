# Curated clang-tidy configuration for JX11.5.
#
# See MODERNIZATION.md (Phase 4). This is intentionally narrower than "*":
# the goal is to catch real defects, not to relitigate style. Style is handled
# by .clang-format.
#
# Run, e.g.:
#   clang-tidy -p build-vscode --warnings-as-errors='bugprone-*,performance-*' \
#              Source/dsp/*.cpp
---
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-return-braced-init-list,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result

WarningsAsErrors: ''

HeaderFilterRegex: '^(Source|Tests)/.*'

FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: 'false'
...
